{
  "name": "@elizonapp/plesk-ts-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the Plesk REST API",
  "license": "MIT",
  "author": "ATT-IT Cloud Services",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ATT-IT-Cloud-Services/plesk-ts-sdk.git"
  },
  "homepage": "https://github.com/ATT-IT-Cloud-Services/plesk-ts-sdk#readme",
  "bugs": {
    "url": "https://github.com/ATT-IT-Cloud-Services/plesk-ts-sdk/issues"
  },
  "keywords": [
    "plesk",
    "plesk-api",
    "sdk",
    "api",
    "typescript",
    "rest",
    "hosting"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "data/cli-function-list.md",
    "examples",
    "LICENSE.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "cli:scrape": "node scripts/scrape-cli-docs.mjs",
    "cli:scrape:fetch": "node scripts/scrape-cli-docs.mjs --fetch",
    "cli:function-list": "node scripts/generate-cli-function-list.mjs",
    "cli:generate": "node scripts/generate-cli.mjs",
    "cli:build": "npm run cli:scrape && npm run cli:function-list && npm run cli:generate",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "smoke": "npm run build && node scripts/smoke-models.mjs && node scripts/smoke-cli.mjs",
    "test:cli": "node scripts/test-cli-parsers.mjs",
    "examples:overview": "node --experimental-strip-types examples/fetch-overview.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "generate-password": "^1.7.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
